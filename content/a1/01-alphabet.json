{
  "level": "A1",
  "topic": null,
  "lesson": { "id": "a1-start-alphabet", "kind": "start", "title_ru": "Алфавит и произношение", "title_uk": "Абетка і вимова", "sort": 1 },
  "items": [
    { "id": "a1-abc-a", "kind": "letter", "de": "A a — der Apfel", "ru": "[а] — яблоко", "uk": "[а] — яблуко", "example_de": "Der Apfel ist rot.", "example_ru": "Яблоко красное.", "example_uk": "Яблуко червоне." },
    { "id": "a1-abc-b", "kind": "letter", "de": "B b — das Brot", "ru": "[бэ] — хлеб", "uk": "[бе] — хліб", "example_de": "Ich kaufe Brot.", "example_ru": "Я покупаю хлеб.", "example_uk": "Я купую хліб." },
    { "id": "a1-abc-c", "kind": "letter", "de": "C c — das Café", "ru": "[цэ] — кафе", "uk": "[це] — кафе", "example_de": "Wir gehen ins Café.", "example_ru": "Мы идём в кафе.", "example_uk": "Ми йдемо в кафе." },
    { "id": "a1-abc-d", "kind": "letter", "de": "D d — die Dusche", "ru": "[дэ] — душ", "uk": "[де] — душ", "example_de": "Die Dusche ist kalt.", "example_ru": "Душ холодный.", "example_uk": "Душ холодний." },
    { "id": "a1-abc-e", "kind": "letter", "de": "E e — essen", "ru": "[э] — есть (кушать)", "uk": "[е] — їсти", "example_de": "Wir essen um sieben.", "example_ru": "Мы ужинаем в семь.", "example_uk": "Ми вечеряємо о сьомій." },
    { "id": "a1-abc-f", "kind": "letter", "de": "F f — die Familie", "ru": "[эф] — семья", "uk": "[еф] — сім'я", "example_de": "Meine Familie wohnt in Kiew.", "example_ru": "Моя семья живёт в Киеве.", "example_uk": "Моя сім'я живе в Києві." },
    { "id": "a1-abc-g", "kind": "letter", "de": "G g — gut", "ru": "[гэ] — хорошо (твёрдое г)", "uk": "[ґе] — добре (тверде ґ)", "example_de": "Das ist gut.", "example_ru": "Это хорошо.", "example_uk": "Це добре." },
    { "id": "a1-abc-h", "kind": "letter", "de": "H h — das Haus", "ru": "[ха] — дом (лёгкий выдох)", "uk": "[га] — будинок (легкий видих)", "example_de": "Das Haus ist groß.", "example_ru": "Дом большой.", "example_uk": "Будинок великий." },
    { "id": "a1-abc-i", "kind": "letter", "de": "I i — der Igel", "ru": "[и] — ёж", "uk": "[і] — їжак", "example_de": "Im Garten ist ein Igel.", "example_ru": "В саду ёж.", "example_uk": "У саду їжак." },
    { "id": "a1-abc-j", "kind": "letter", "de": "J j — ja", "ru": "[йот] — да", "uk": "[йот] — так", "example_de": "Ja, das stimmt.", "example_ru": "Да, верно.", "example_uk": "Так, правильно." },
    { "id": "a1-abc-k", "kind": "letter", "de": "K k — das Kind", "ru": "[ка] — ребёнок", "uk": "[ка] — дитина", "example_de": "Das Kind spielt.", "example_ru": "Ребёнок играет.", "example_uk": "Дитина грається." },
    { "id": "a1-abc-l", "kind": "letter", "de": "L l — lernen", "ru": "[эль] — учить", "uk": "[ель] — вчити", "example_de": "Ich lerne jeden Tag.", "example_ru": "Я учусь каждый день.", "example_uk": "Я вчуся щодня." },
    { "id": "a1-abc-m", "kind": "letter", "de": "M m — die Milch", "ru": "[эм] — молоко", "uk": "[ем] — молоко", "example_de": "Die Milch ist im Kühlschrank.", "example_ru": "Молоко в холодильнике.", "example_uk": "Молоко в холодильнику." },
    { "id": "a1-abc-n", "kind": "letter", "de": "N n — der Name", "ru": "[эн] — имя", "uk": "[ен] — ім'я", "example_de": "Wie ist Ihr Name?", "example_ru": "Как вас зовут?", "example_uk": "Як вас звати?" },
    { "id": "a1-abc-o", "kind": "letter", "de": "O o — das Obst", "ru": "[о] — фрукты", "uk": "[о] — фрукти", "example_de": "Obst ist gesund.", "example_ru": "Фрукты полезны.", "example_uk": "Фрукти корисні." },
    { "id": "a1-abc-p", "kind": "letter", "de": "P p — die Post", "ru": "[пэ] — почта", "uk": "[пе] — пошта", "example_de": "Die Post ist heute zu.", "example_ru": "Почта сегодня закрыта.", "example_uk": "Пошта сьогодні зачинена." },
    { "id": "a1-abc-q", "kind": "letter", "de": "Qu qu — die Quittung", "ru": "[ку] читается [кв] — квитанция, чек", "uk": "[ку] читається [кв] — квитанція, чек", "example_de": "Brauchen Sie eine Quittung?", "example_ru": "Вам нужен чек?", "example_uk": "Вам потрібен чек?" },
    { "id": "a1-abc-r", "kind": "letter", "de": "R r — rot", "ru": "[эр] — красный (горловое r)", "uk": "[ер] — червоний (горлове r)", "example_de": "Die Ampel ist rot.", "example_ru": "Светофор красный.", "example_uk": "Світлофор червоний.", "tags": ["pronunciation"] },
    { "id": "a1-abc-s", "kind": "letter", "de": "S s — die Sonne", "ru": "[эс] — солнце (s перед гласной = [з])", "uk": "[ес] — сонце (s перед голосною = [з])", "example_de": "Die Sonne scheint.", "example_ru": "Светит солнце.", "example_uk": "Світить сонце." },
    { "id": "a1-abc-t", "kind": "letter", "de": "T t — der Tee", "ru": "[тэ] — чай", "uk": "[те] — чай", "example_de": "Möchtest du Tee?", "example_ru": "Хочешь чаю?", "example_uk": "Хочеш чаю?" },
    { "id": "a1-abc-u", "kind": "letter", "de": "U u — die Uhr", "ru": "[у] — часы", "uk": "[у] — годинник", "example_de": "Die Uhr ist neu.", "example_ru": "Часы новые.", "example_uk": "Годинник новий." },
    { "id": "a1-abc-v", "kind": "letter", "de": "V v — der Vater", "ru": "[фау] — отец (v обычно = [ф])", "uk": "[фау] — батько (v зазвичай = [ф])", "example_de": "Mein Vater arbeitet viel.", "example_ru": "Мой отец много работает.", "example_uk": "Мій батько багато працює." },
    { "id": "a1-abc-w", "kind": "letter", "de": "W w — das Wasser", "ru": "[вэ] — вода (w = [в])", "uk": "[ве] — вода (w = [в])", "example_de": "Ein Glas Wasser, bitte.", "example_ru": "Стакан воды, пожалуйста.", "example_uk": "Склянку води, будь ласка." },
    { "id": "a1-abc-x", "kind": "letter", "de": "X x — das Taxi", "ru": "[икс] — такси", "uk": "[ікс] — таксі", "example_de": "Wir nehmen ein Taxi.", "example_ru": "Мы возьмём такси.", "example_uk": "Ми візьмемо таксі." },
    { "id": "a1-abc-y", "kind": "letter", "de": "Y y — das Handy", "ru": "[ипсилон] — мобильный телефон", "uk": "[іпсилон] — мобільний телефон", "example_de": "Mein Handy ist leer.", "example_ru": "У меня сел телефон.", "example_uk": "У мене розрядився телефон." },
    { "id": "a1-abc-z", "kind": "letter", "de": "Z z — die Zeit", "ru": "[цэт] — время (z = [ц])", "uk": "[цет] — час (z = [ц])", "example_de": "Hast du Zeit?", "example_ru": "У тебя есть время?", "example_uk": "У тебе є час?" },
    { "id": "a1-abc-ae", "kind": "letter", "de": "Ä ä — der Käse", "ru": "[э] — сыр", "uk": "[е] — сир", "example_de": "Der Käse ist lecker.", "example_ru": "Сыр вкусный.", "example_uk": "Сир смачний.", "tags": ["pronunciation", "umlaut"] },
    { "id": "a1-abc-oe", "kind": "letter", "de": "Ö ö — schön", "ru": "[ё] без «й»: губы как для «о», язык как для «э» — красивый", "uk": "[ьо] без «й»: губи як для «о», язик як для «е» — гарний", "example_de": "Das Wetter ist schön.", "example_ru": "Погода хорошая.", "example_uk": "Погода гарна.", "tags": ["pronunciation", "umlaut"] },
    { "id": "a1-abc-ue", "kind": "letter", "de": "Ü ü — müde", "ru": "[ю] без «й»: губы как для «у», язык как для «и» — уставший", "uk": "[ю] без «й»: губи як для «у», язик як для «і» — втомлений", "example_de": "Ich bin heute sehr müde.", "example_ru": "Я сегодня очень устал(а).", "example_uk": "Я сьогодні дуже втомився (втомилася).", "tags": ["pronunciation", "umlaut"] },
    { "id": "a1-abc-ss", "kind": "letter", "de": "ß — die Straße", "ru": "[эсцэт] = долгое [с] — улица", "uk": "[есцет] = довге [с] — вулиця", "example_de": "Ich wohne in der Hauptstraße.", "example_ru": "Я живу на Хауптштрассе.", "example_uk": "Я живу на Гауптштрассе." },
    { "id": "a1-abc-ch1", "kind": "letter", "de": "ch — ich, nicht", "ru": "после e, i, ä, ö, ü: мягкое шипящее [хь]", "uk": "після e, i, ä, ö, ü: м'яке шипляче [хь]", "example_de": "Ich spreche nicht viel.", "example_ru": "Я говорю немного.", "example_uk": "Я розмовляю небагато.", "tags": ["pronunciation"] },
    { "id": "a1-abc-ch2", "kind": "letter", "de": "ch — acht, Buch", "ru": "после a, o, u: твёрдое [х]", "uk": "після a, o, u: тверде [х]", "example_de": "Das Buch kostet acht Euro.", "example_ru": "Книга стоит восемь евро.", "example_uk": "Книжка коштує вісім євро.", "tags": ["pronunciation"] },
    { "id": "a1-abc-sch", "kind": "letter", "de": "sch — die Schule", "ru": "[ш] — школа", "uk": "[ш] — школа", "example_de": "Die Schule beginnt um acht.", "example_ru": "Школа начинается в восемь.", "example_uk": "Школа починається о восьмій." },
    { "id": "a1-abc-st", "kind": "letter", "de": "st / sp — die Stadt, der Sport", "ru": "в начале слова [шт] / [шп]", "uk": "на початку слова [шт] / [шп]", "example_de": "In der Stadt gibt es viel Sport.", "example_ru": "В городе много спорта.", "example_uk": "У місті багато спорту." },
    { "id": "a1-abc-ei", "kind": "letter", "de": "ei — drei, klein", "ru": "[ай]", "uk": "[ай]", "example_de": "Ich habe drei kleine Kinder.", "example_ru": "У меня трое маленьких детей.", "example_uk": "У мене троє маленьких дітей.", "tags": ["pronunciation"] },
    { "id": "a1-abc-ie", "kind": "letter", "de": "ie — die Liebe, vier", "ru": "долгое [и:]", "uk": "довге [і:]", "example_de": "Wir sind vier Personen.", "example_ru": "Нас четыре человека.", "example_uk": "Нас четверо.", "tags": ["pronunciation"] },
    { "id": "a1-abc-eu", "kind": "letter", "de": "eu / äu — heute, Häuser", "ru": "[ой]", "uk": "[ой]", "example_de": "Heute ist es kalt.", "example_ru": "Сегодня холодно.", "example_uk": "Сьогодні холодно.", "tags": ["pronunciation"] },
    { "id": "a1-abc-er", "kind": "letter", "de": "-er — der Lehrer, die Mutter", "ru": "на конце слова почти [а]: «лера», «мута»", "uk": "у кінці слова майже [а]: «лера», «мута»", "example_de": "Meine Mutter ist Lehrerin.", "example_ru": "Моя мама — учительница.", "example_uk": "Моя мама — вчителька.", "tags": ["pronunciation"] }
  ]
}
