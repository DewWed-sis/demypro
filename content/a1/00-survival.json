{
  "level": "A1",
  "topic": null,
  "lesson": { "id": "a1-start-survival", "kind": "start", "title_ru": "100 фраз выживания", "title_uk": "100 фраз виживання", "sort": 3 },
  "items": [
    { "id": "a1-s-001", "de": "Hallo!", "ru": "Привет! / Здравствуйте!", "uk": "Привіт! / Добрий день!" },
    { "id": "a1-s-002", "de": "Guten Morgen!", "ru": "Доброе утро!", "uk": "Доброго ранку!" },
    { "id": "a1-s-003", "de": "Guten Tag!", "ru": "Добрый день!", "uk": "Добрий день!" },
    { "id": "a1-s-004", "de": "Guten Abend!", "ru": "Добрый вечер!", "uk": "Добрий вечір!" },
    { "id": "a1-s-005", "de": "Tschüss!", "ru": "Пока!", "uk": "Бувай!" },
    { "id": "a1-s-006", "de": "Auf Wiedersehen!", "ru": "До свидания!", "uk": "До побачення!" },
    { "id": "a1-s-007", "de": "Bis morgen!", "ru": "До завтра!", "uk": "До завтра!" },
    { "id": "a1-s-008", "de": "Bis später!", "ru": "До скорого! / Увидимся позже!", "uk": "До зустрічі! / Побачимось пізніше!" },
    { "id": "a1-s-009", "de": "Danke!", "ru": "Спасибо!", "uk": "Дякую!" },
    { "id": "a1-s-010", "de": "Vielen Dank!", "ru": "Большое спасибо!", "uk": "Щиро дякую!" },
    { "id": "a1-s-011", "de": "Bitte.", "ru": "Пожалуйста.", "uk": "Будь ласка." },
    { "id": "a1-s-012", "de": "Gern geschehen.", "ru": "Не за что.", "uk": "Нема за що." },
    { "id": "a1-s-013", "de": "Entschuldigung!", "ru": "Извините!", "uk": "Вибачте!" },
    { "id": "a1-s-014", "de": "Tut mir leid.", "ru": "Мне жаль. / Простите.", "uk": "Мені шкода. / Перепрошую." },
    { "id": "a1-s-015", "de": "Kein Problem.", "ru": "Без проблем.", "uk": "Без проблем." },
    { "id": "a1-s-016", "de": "Ja, gern.", "ru": "Да, с удовольствием.", "uk": "Так, із задоволенням." },
    { "id": "a1-s-017", "de": "Nein, danke.", "ru": "Нет, спасибо.", "uk": "Ні, дякую." },
    { "id": "a1-s-018", "de": "Wie geht's?", "ru": "Как дела?", "uk": "Як справи?" },
    { "id": "a1-s-019", "de": "Gut, danke. Und dir?", "ru": "Хорошо, спасибо. А у тебя?", "uk": "Добре, дякую. А в тебе?" },
    { "id": "a1-s-020", "de": "Wie geht es Ihnen?", "ru": "Как у вас дела? (вежливо)", "uk": "Як у вас справи? (ввічливо)" },
    { "id": "a1-s-021", "de": "Es geht.", "ru": "Так себе.", "uk": "Так собі." },
    { "id": "a1-s-022", "de": "Ich heiße Anna.", "ru": "Меня зовут Анна.", "uk": "Мене звати Анна.", "cloze": "Ich ___ Anna." },
    { "id": "a1-s-023", "de": "Wie heißt du?", "ru": "Как тебя зовут?", "uk": "Як тебе звати?" },
    { "id": "a1-s-024", "de": "Wie ist Ihr Name?", "ru": "Как ваша фамилия / ваше имя?", "uk": "Як ваше прізвище / ваше ім'я?" },
    { "id": "a1-s-025", "de": "Ich komme aus der Ukraine.", "ru": "Я из Украины.", "uk": "Я з України.", "cloze": "Ich komme ___ der Ukraine." },
    { "id": "a1-s-026", "de": "Woher kommst du?", "ru": "Откуда ты?", "uk": "Звідки ти?" },
    { "id": "a1-s-027", "de": "Ich wohne in Köln.", "ru": "Я живу в Кёльне.", "uk": "Я живу в Кельні.", "cloze": "Ich ___ in Köln." },
    { "id": "a1-s-028", "de": "Freut mich!", "ru": "Очень приятно!", "uk": "Дуже приємно!" },
    { "id": "a1-s-029", "de": "Ich verstehe das nicht.", "ru": "Я этого не понимаю.", "uk": "Я цього не розумію.", "cloze": "Ich ___ das nicht." },
    { "id": "a1-s-030", "de": "Können Sie das bitte wiederholen?", "ru": "Повторите, пожалуйста?", "uk": "Повторіть, будь ласка?" },
    { "id": "a1-s-031", "de": "Langsamer, bitte.", "ru": "Помедленнее, пожалуйста.", "uk": "Повільніше, будь ласка." },
    { "id": "a1-s-032", "de": "Was bedeutet das?", "ru": "Что это значит?", "uk": "Що це означає?" },
    { "id": "a1-s-033", "de": "Wie sagt man das auf Deutsch?", "ru": "Как это сказать по-немецки?", "uk": "Як це сказати німецькою?" },
    { "id": "a1-s-034", "de": "Wie schreibt man das?", "ru": "Как это пишется?", "uk": "Як це пишеться?" },
    { "id": "a1-s-035", "de": "Ich spreche nur ein bisschen Deutsch.", "ru": "Я говорю по-немецки совсем немного.", "uk": "Я розмовляю німецькою зовсім трохи.", "cloze": "Ich spreche nur ein ___ Deutsch." },
    { "id": "a1-s-036", "de": "Sprechen Sie Englisch?", "ru": "Вы говорите по-английски?", "uk": "Ви розмовляєте англійською?" },
    { "id": "a1-s-037", "de": "Ich lerne Deutsch.", "ru": "Я учу немецкий.", "uk": "Я вчу німецьку." },
    { "id": "a1-s-038", "de": "Keine Ahnung.", "ru": "Понятия не имею.", "uk": "Гадки не маю." },
    { "id": "a1-s-039", "de": "Ich weiß es nicht.", "ru": "Я не знаю.", "uk": "Я не знаю." },
    { "id": "a1-s-040", "de": "Einen Moment, bitte.", "ru": "Минутку, пожалуйста.", "uk": "Хвилинку, будь ласка." },
    { "id": "a1-s-041", "de": "Können Sie mir helfen?", "ru": "Вы можете мне помочь?", "uk": "Ви можете мені допомогти?", "cloze": "Können Sie ___ helfen?" },
    { "id": "a1-s-042", "de": "Ich brauche Hilfe.", "ru": "Мне нужна помощь.", "uk": "Мені потрібна допомога." },
    { "id": "a1-s-043", "de": "Wo ist die Toilette?", "ru": "Где туалет?", "uk": "Де туалет?" },
    { "id": "a1-s-044", "de": "Wo ist der Bahnhof?", "ru": "Где вокзал?", "uk": "Де вокзал?" },
    { "id": "a1-s-045", "de": "Wie komme ich zum Rathaus?", "ru": "Как мне пройти к ратуше?", "uk": "Як мені дійти до ратуші?", "cloze": "Wie komme ich ___ Rathaus?" },
    { "id": "a1-s-046", "de": "Geradeaus und dann links.", "ru": "Прямо, а потом налево.", "uk": "Прямо, а потім ліворуч." },
    { "id": "a1-s-047", "de": "Ist das weit von hier?", "ru": "Это далеко отсюда?", "uk": "Це далеко звідси?" },
    { "id": "a1-s-048", "de": "Wie viel kostet das?", "ru": "Сколько это стоит?", "uk": "Скільки це коштує?" },
    { "id": "a1-s-049", "de": "Das ist zu teuer.", "ru": "Это слишком дорого.", "uk": "Це занадто дорого." },
    { "id": "a1-s-050", "de": "Ich nehme das.", "ru": "Я возьму это.", "uk": "Я візьму це." },
    { "id": "a1-s-051", "de": "Kann ich mit Karte zahlen?", "ru": "Можно заплатить картой?", "uk": "Можна заплатити карткою?", "cloze": "Kann ich mit Karte ___?" },
    { "id": "a1-s-052", "de": "Bar oder mit Karte?", "ru": "Наличными или картой?", "uk": "Готівкою чи карткою?" },
    { "id": "a1-s-053", "de": "Brauchen Sie eine Tüte?", "ru": "Вам нужен пакет?", "uk": "Вам потрібен пакет?" },
    { "id": "a1-s-054", "de": "Ich hätte gern einen Kaffee.", "ru": "Я бы хотел(а) кофе.", "uk": "Я б хотів (хотіла) каву.", "cloze": "Ich ___ gern einen Kaffee." },
    { "id": "a1-s-055", "de": "Die Rechnung, bitte.", "ru": "Счёт, пожалуйста.", "uk": "Рахунок, будь ласка." },
    { "id": "a1-s-056", "de": "Zum Mitnehmen, bitte.", "ru": "С собой, пожалуйста.", "uk": "З собою, будь ласка." },
    { "id": "a1-s-057", "de": "Stimmt so.", "ru": "Сдачи не надо.", "uk": "Решти не треба." },
    { "id": "a1-s-058", "de": "Haben Sie noch einen Tisch frei?", "ru": "У вас есть свободный столик?", "uk": "У вас є вільний столик?" },
    { "id": "a1-s-059", "de": "Ich bin Vegetarier.", "ru": "Я вегетарианец.", "uk": "Я вегетаріанець." },
    { "id": "a1-s-060", "de": "Wie spät ist es?", "ru": "Который час?", "uk": "Котра година?" },
    { "id": "a1-s-061", "de": "Es ist halb drei.", "ru": "Половина третьего (2:30).", "uk": "Пів на третю (2:30)." },
    { "id": "a1-s-062", "de": "Wann fährt der Zug?", "ru": "Когда отправляется поезд?", "uk": "Коли відправляється потяг?" },
    { "id": "a1-s-063", "de": "Eine Fahrkarte nach Berlin, bitte.", "ru": "Один билет до Берлина, пожалуйста.", "uk": "Один квиток до Берліна, будь ласка.", "cloze": "Eine Fahrkarte ___ Berlin, bitte." },
    { "id": "a1-s-064", "de": "Hält dieser Bus am Hauptbahnhof?", "ru": "Этот автобус останавливается у главного вокзала?", "uk": "Цей автобус зупиняється біля головного вокзалу?" },
    { "id": "a1-s-065", "de": "Wo muss ich umsteigen?", "ru": "Где мне нужно пересесть?", "uk": "Де мені треба пересісти?" },
    { "id": "a1-s-066", "de": "Der Zug hat Verspätung.", "ru": "Поезд опаздывает.", "uk": "Потяг запізнюється." },
    { "id": "a1-s-067", "de": "Ich habe einen Termin um zehn Uhr.", "ru": "У меня запись (встреча) на десять часов.", "uk": "У мене запис (зустріч) на десяту годину.", "cloze": "Ich habe einen ___ um zehn Uhr." },
    { "id": "a1-s-068", "de": "Ich möchte einen Termin machen.", "ru": "Я хочу записаться (на приём).", "uk": "Я хочу записатися (на прийом)." },
    { "id": "a1-s-069", "de": "Ich komme etwas später.", "ru": "Я немного опоздаю.", "uk": "Я трохи запізнюся." },
    { "id": "a1-s-070", "de": "Ich bin krank.", "ru": "Я болею.", "uk": "Я хворію." },
    { "id": "a1-s-071", "de": "Mir geht es nicht gut.", "ru": "Мне нехорошо.", "uk": "Мені погано." },
    { "id": "a1-s-072", "de": "Ich habe Kopfschmerzen.", "ru": "У меня болит голова.", "uk": "У мене болить голова." },
    { "id": "a1-s-073", "de": "Ich brauche einen Arzt.", "ru": "Мне нужен врач.", "uk": "Мені потрібен лікар." },
    { "id": "a1-s-074", "de": "Rufen Sie bitte einen Krankenwagen!", "ru": "Вызовите, пожалуйста, скорую!", "uk": "Викличте, будь ласка, швидку!" },
    { "id": "a1-s-075", "de": "Hilfe!", "ru": "Помогите!", "uk": "Допоможіть!" },
    { "id": "a1-s-076", "de": "Achtung!", "ru": "Внимание! / Осторожно!", "uk": "Увага! / Обережно!" },
    { "id": "a1-s-077", "de": "Ich habe mich verlaufen.", "ru": "Я заблудился (заблудилась).", "uk": "Я заблукав (заблукала)." },
    { "id": "a1-s-078", "de": "Meine Telefonnummer ist …", "ru": "Мой номер телефона …", "uk": "Мій номер телефону …" },
    { "id": "a1-s-079", "de": "Können Sie das bitte buchstabieren?", "ru": "Можете это продиктовать по буквам?", "uk": "Можете це продиктувати по літерах?" },
    { "id": "a1-s-080", "de": "Ich bin verheiratet.", "ru": "Я женат / замужем.", "uk": "Я одружений / заміжня." },
    { "id": "a1-s-081", "de": "Ich habe zwei Kinder.", "ru": "У меня двое детей.", "uk": "У мене двоє дітей.", "cloze": "Ich ___ zwei Kinder." },
    { "id": "a1-s-082", "de": "Ich bin 35 Jahre alt.", "ru": "Мне 35 лет.", "uk": "Мені 35 років.", "cloze": "Ich ___ 35 Jahre alt." },
    { "id": "a1-s-083", "de": "Ich arbeite als Krankenpfleger.", "ru": "Я работаю медбратом.", "uk": "Я працюю медбратом.", "cloze": "Ich arbeite ___ Krankenpfleger." },
    { "id": "a1-s-084", "de": "Ich suche Arbeit.", "ru": "Я ищу работу.", "uk": "Я шукаю роботу." },
    { "id": "a1-s-085", "de": "Ich suche eine Wohnung.", "ru": "Я ищу квартиру.", "uk": "Я шукаю квартиру." },
    { "id": "a1-s-086", "de": "Die Heizung ist kaputt.", "ru": "Отопление сломалось.", "uk": "Опалення зламалося." },
    { "id": "a1-s-087", "de": "Das macht nichts.", "ru": "Ничего страшного.", "uk": "Нічого страшного." },
    { "id": "a1-s-088", "de": "Alles klar!", "ru": "Всё ясно! / Понятно!", "uk": "Усе зрозуміло!" },
    { "id": "a1-s-089", "de": "Genau!", "ru": "Точно! / Именно!", "uk": "Саме так!" },
    { "id": "a1-s-090", "de": "Super, danke!", "ru": "Супер, спасибо!", "uk": "Супер, дякую!" },
    { "id": "a1-s-091", "de": "Schönes Wochenende!", "ru": "Хороших выходных!", "uk": "Гарних вихідних!" },
    { "id": "a1-s-092", "de": "Gleichfalls!", "ru": "И вам того же!", "uk": "І вам того ж!" },
    { "id": "a1-s-093", "de": "Viel Glück!", "ru": "Удачи!", "uk": "Удачі!" },
    { "id": "a1-s-094", "de": "Herzlichen Glückwunsch!", "ru": "Поздравляю!", "uk": "Вітаю!" },
    { "id": "a1-s-095", "de": "Guten Appetit!", "ru": "Приятного аппетита!", "uk": "Смачного!" },
    { "id": "a1-s-096", "de": "Prost!", "ru": "Будем! (тост)", "uk": "Будьмо! (тост)" },
    { "id": "a1-s-097", "de": "Darf ich hier sitzen?", "ru": "Можно здесь сесть?", "uk": "Можна тут сісти?", "cloze": "___ ich hier sitzen?" },
    { "id": "a1-s-098", "de": "Ist hier noch frei?", "ru": "Здесь свободно?", "uk": "Тут вільно?" },
    { "id": "a1-s-099", "de": "Wir duzen uns, okay?", "ru": "Давай на «ты», хорошо?", "uk": "Давай на «ти», добре?" },
    { "id": "a1-s-100", "de": "Bis bald!", "ru": "До скорого!", "uk": "До скорого!" }
  ]
}
