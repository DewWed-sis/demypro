# Supabase (Project Settings → API). Публичные значения, защищены RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Только локально для npm run seed / npm run tts. Никогда не коммитить и не класть в Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Ключ Groq НЕ кладётся в env: каждый пользователь вводит свой в настройках (BYOK, localStorage).
